# make install's user unit serves the trees that its build's .LOCK files
# name, from login to logout. Enable it with:
# systemctl --user enable @NAME@-dev
# --restart starts a server for each address whose registry links a .LOCK
# and names this build. The package's units serve the trees its binary
# served last, so this unit runs beside them.
# Stopping the unit sends its servers SIGTERM, which keeps every .LOCK.
[Unit]
Description=@NAME@-dev: serve the trees that make install's build last served

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@BIN@ --restart

[Install]
WantedBy=default.target
